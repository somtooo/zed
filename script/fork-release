#!/usr/bin/env bash
# Cut a tagged release snapshot of this fork's main.
#
# Tag scheme: fork-<latest stable upstream release> (e.g. fork-v1.20.2).
# "Stable" means the vX.Y.Z tags with no -pre suffix; -pre tags are skipped.
# A `fork-*` namespace can never collide with upstream's `v*` tags. If the
# tag already exists (re-release off the same upstream), a .N suffix is added.
#
# A full gate (./script/fork-checks: clippy + nextest workspace + doctests,
# the same bar upstream gates PRs on) runs before tagging unless --skip-verify
# is given -- in that case only release when the fork-checks workflow is green
# on HEAD. Verify after every merge conflict the same way.
#
# Usage:
#   script/fork-release [--dry-run] [--skip-verify] [<tag>]
#
# Run from an up-to-date main (see script/fork-sync first).

set -euo pipefail

cd "$(dirname "$0")/.." || exit 1

DRY_RUN=false
SKIP_VERIFY=false
TAG=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --skip-verify)
            SKIP_VERIFY=true
            shift
            ;;
        -h | --help)
            echo "Usage: script/fork-release [--dry-run] [--skip-verify] [<tag>]"
            exit 0
            ;;
        -*)
            echo "Unknown argument: $1 (see --help)" >&2
            exit 1
            ;;
        *)
            TAG="$1"
            shift
            ;;
    esac
done

latest_stable_upstream() {
    local tags
    tags=$(git ls-remote --tags --refs upstream 2>/dev/null | awk '{print $2}' | sed 's|refs/tags/||' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' || true)
    if [ -z "$tags" ]; then
        tags=$(git tag --list 'v[0-9]*.[0-9]*.[0-9]*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' || true)
    fi
    echo "$tags" | sort -V | tail -n 1
}

if [ -z "$TAG" ]; then
    STABLE=$(latest_stable_upstream)
    if [ -z "$STABLE" ]; then
        echo "error: could not determine latest stable upstream tag" >&2
        exit 1
    fi
    BASE="fork-$STABLE"
    TAG="$BASE"
    N=1
    while git rev-parse --verify --quiet "refs/tags/$TAG" >/dev/null; do
        N=$((N + 1))
        TAG="$BASE.$N"
    done
fi

case "$TAG" in
    fork-v*) ;;
    *)
        echo "error: tag must look like 'fork-vX.Y.Z' (got '$TAG')" >&2
        exit 1
        ;;
esac

if git rev-parse --verify --quiet "refs/tags/$TAG" >/dev/null; then
    echo "error: tag $TAG already exists" >&2
    exit 1
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "error: working tree is dirty -- commit or stash first" >&2
    exit 1
fi

BRANCH=$(git branch --show-current)
if [ "$BRANCH" != "main" ]; then
    echo "error: run from main (currently on '$BRANCH')" >&2
    exit 1
fi

UPSTREAM_BASE=$(git merge-base main upstream/main 2>/dev/null || echo "unknown")
LAST_FORK_TAG=$(git describe --tags --match 'fork-*' --abbrev=0 2>/dev/null || echo "")

echo "Tag:               $TAG"
echo "HEAD:              $(git rev-parse --short HEAD) $(git log -1 --format=%s)"
echo "Upstream base:     $UPSTREAM_BASE"
if [ -n "$LAST_FORK_TAG" ]; then
    echo "Previous fork tag: $LAST_FORK_TAG"
fi

if [ "$DRY_RUN" = true ]; then
    echo "--dry-run: not creating anything."
    exit 0
fi

if [ "$SKIP_VERIFY" = true ]; then
    echo "WARNING: skipping checks -- only release if fork-checks is green on HEAD."
else
    ./script/fork-checks
fi

git tag -a "$TAG" -m "Fork release $TAG

Upstream base: $UPSTREAM_BASE"
git push origin "$TAG"

if command -v gh >/dev/null 2>&1; then
    gh release create "$TAG" --title "$TAG" \
        --notes "Fork snapshot of main at $(git rev-parse --short HEAD) (upstream base $UPSTREAM_BASE)." \
        --generate-notes
    echo "Release: $(gh release view "$TAG" --json url -q .url 2>/dev/null || echo "(see gh release view $TAG)")"
else
    echo "gh not found -- tag pushed; create the Release in the web UI."
fi
