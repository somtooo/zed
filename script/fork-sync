#!/usr/bin/env bash
# Keep this fork synced with upstream (zed-industries/zed).
#
# Model: main is a pristine mirror of upstream/main (fast-forward only --
# it must never diverge). develop carries all custom commits linearly on
# top of main. Syncing means: fast-forward main, then rebase develop.
# There are no merge commits anywhere in this flow.
#
# Fully automated: fast-forwards and clean rebases push directly.
# On rebase conflict the script resolves with opencode headlessly
# (Muse Spark 1.3, xhigh reasoning) then verifies before pushing.
# CI (fork-sync.yml) does the same minus AI: on conflict it aborts and fails
# so you resolve locally -- no AI auto-resolve in CI by design (needs
# secrets, non-deterministic, and rebase conflicts deserve a local build).
#
# Usage:
#   script/fork-sync [--dry-run] [--no-push] [--no-ai] [--skip-verify]
#                    [--upstream <remote>] [--model <m>] [--variant <v>]
#
#   --dry-run         print the plan (how far each branch trails) and exit
#                     before moving anything
#   --no-push         leave both branches local (no pushes)
#   --no-ai           don't call opencode; abort on conflict for manual fix
#   --skip-verify     skip ./script/fork-checks after a rebase (pushed develop
#                     gets no CI run -- this is the only gate, so skipping is
#                     at your own risk)
#   --upstream <name> upstream remote name (default: upstream)
#   --model <m>       opencode model (default: opencode/muse-spark-1.3-contributor-free)
#   --variant <v>     model reasoning variant (default: xhigh)

set -euo pipefail

cd "$(dirname "$0")/.." || exit 1

DRY_RUN=false
PUSH=true
AI=true
SKIP_VERIFY=false
UPSTREAM="upstream"
MODEL="opencode/muse-spark-1.3-contributor-free"
VARIANT="xhigh"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --no-push)
            PUSH=false
            shift
            ;;
        --no-ai)
            AI=false
            shift
            ;;
        --skip-verify)
            SKIP_VERIFY=true
            shift
            ;;
        --upstream)
            UPSTREAM="$2"
            shift 2
            ;;
        --model)
            MODEL="$2"
            shift 2
            ;;
        --variant)
            VARIANT="$2"
            shift 2
            ;;
        -h | --help)
            echo "Usage: script/fork-sync [--dry-run] [--no-push] [--no-ai] [--skip-verify] [--upstream <remote>] [--model <m>] [--variant <v>]"
            exit 0
            ;;
        *)
            echo "Unknown argument: $1 (see --help)" >&2
            exit 1
            ;;
    esac
done

if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "error: working tree is dirty -- commit or stash first" >&2
    exit 1
fi

if ! git remote get-url "$UPSTREAM" >/dev/null 2>&1; then
    echo "error: no '$UPSTREAM' remote -- add it with:" >&2
    echo "  git remote add upstream https://github.com/zed-industries/zed.git" >&2
    exit 1
fi

command -v gh >/dev/null 2>&1 || {
    echo "error: gh CLI required (push + checks dispatch)" >&2
    exit 1
}

git fetch "$UPSTREAM"
git fetch origin

if ! git show-ref --verify --quiet refs/heads/main; then
    echo "error: no local main branch" >&2
    exit 1
fi
if ! git show-ref --verify --quiet refs/heads/develop; then
    echo "error: no local develop branch" >&2
    exit 1
fi

MAIN_BEHIND=$(git rev-list --count main.."$UPSTREAM"/main)
MAIN_AHEAD=$(git rev-list --count "$UPSTREAM"/main..main)
DEV_BEHIND_MAIN=$(git rev-list --count develop..main)

echo "main is $MAIN_AHEAD ahead / $MAIN_BEHIND behind $UPSTREAM/main"
echo "develop is $DEV_BEHIND_MAIN behind main"

if [ "$MAIN_AHEAD" -ne 0 ]; then
    echo "error: main has diverged from $UPSTREAM/main ($MAIN_AHEAD commits) --" >&2
    echo "main must stay a pristine mirror. Reset it explicitly, never merge:" >&2
    echo "  git checkout main && git reset --hard $UPSTREAM/main" >&2
    exit 1
fi

if [ "$MAIN_BEHIND" -eq 0 ] && [ "$DEV_BEHIND_MAIN" -eq 0 ]; then
    echo "Already up to date -- nothing to do."
    exit 0
fi

if [ "$DRY_RUN" = true ]; then
    if [ "$MAIN_BEHIND" -ne 0 ]; then
        echo "Would fast-forward main by $MAIN_BEHIND commit(s)."
    fi
    COMMITS=$(git rev-list --count main..develop)
    if [ "$MAIN_BEHIND" -ne 0 ] || [ "$DEV_BEHIND_MAIN" -ne 0 ]; then
        echo "Would rebase $COMMITS develop commit(s) onto the new main."
    fi
    echo "--dry-run: not moving anything."
    exit 0
fi

MAIN_MOVED=false
if [ "$MAIN_BEHIND" -ne 0 ]; then
    git checkout -q main
    git merge --ff-only "$UPSTREAM"/main
    MAIN_MOVED=true
    echo "main fast-forwarded to $(git rev-parse --short main)"
fi

git checkout -q develop
REBASED=false
if ! git rebase main; then
    if [ "$AI" = false ]; then
        git rebase --abort
        echo "Aborted (--no-ai). Resolve manually: rebase develop onto main, then push." >&2
        exit 1
    fi
    command -v opencode >/dev/null 2>&1 || {
        git rebase --abort
        echo "error: opencode CLI not found -- install it or re-run with --no-ai" >&2
        exit 1
    }
    echo "Resolving rebase with opencode ($MODEL, variant $VARIANT) ..."
    while git rev-parse --verify --quiet REBASE_HEAD >/dev/null; do
        CONFLICTS=$(git diff --name-only --diff-filter=U || true)
        if [ -z "$CONFLICTS" ]; then
            git rebase --abort
            echo "error: rebase stopped with no conflicted files (likely an emptied commit) --" >&2
            echo "inspect with 'git status', then continue manually ('git rebase --continue/--skip')." >&2
            exit 1
        fi
        echo "Conflicted files:"
        echo "$CONFLICTS"
        STOP_SHA=$(git rev-parse --short REBASE_HEAD)
        STOP_SUBJECT=$(git log -1 --format=%s REBASE_HEAD)
        if ! opencode run -m "$MODEL" --variant "$VARIANT" "You are resolving a git rebase conflict in this repo. Context: branch develop (all custom fork commits, kept linear) is being rebased onto the new main tip (pure upstream). Replaying commit $STOP_SHA ($STOP_SUBJECT) just conflicted; these files now contain git conflict markers: $CONFLICTS.

Our fork features you must PRESERVE (never delete to 'resolve' a conflict):
- markdown theme syntax colors (crates/markdown)
- selection comments queued into the agent thread draft (crates/editor/src/selection_comments.rs, crates/agent_ui/src/selection_comments.rs)
- automatic terminal card collapse (crates/agent_ui thread_view/entry_view_state)
- anchored agent responses with Alt-scroll navigation (crates/agent_ui conversation_view)

How to resolve this stop:
1. Inspect every conflict hunk (grep -n '^<<<<<<< \|^=======$\|^>>>>>>> ' in each file). Use 'git show :2:<file>' (BASE, upstream) and 'git show :3:<file>' (THEIRS, our commit) to understand what each side intended.
2. Merge SEMANTICALLY: keep the feature's intent, adapted to the new base's APIs. When upstream refactored code our feature touches, adapt our feature to the new shape -- do not revert the refactor and do not drop our feature. Do NOT pull newer upstream code into an older base; adapt minimally. If a hunk is genuinely ambiguous, prefer keeping upstream behavior and note the choice in your final summary.
3. Follow this repo's Rust rules (AGENTS.md): no unwrap()/expect() in new code, propagate errors with ?, handle fallible results explicitly, full-word variable names, and keep diffs minimal -- no drive-by reformatting.
4. Remove ALL conflict markers. After editing each file, stage it with 'git add <file>'. Do NOT commit and do NOT run 'git rebase --continue' -- the script continues the rebase after verifying.
5. When all files are staged, run 'git diff --check' (must be clean) and verify no markers remain (rg -n '^<{7} |^={7}$\|^>{7} ' on the touched files).

Final summary must list: each file, what each side changed, and how you reconciled it."; then
            git rebase --abort
            echo "error: opencode run failed -- rebase aborted." >&2
            exit 1
        fi
        if [ -n "$(git diff --name-only --diff-filter=U || true)" ]; then
            git rebase --abort
            echo "error: conflicts remain after opencode -- rebase aborted." >&2
            echo "Re-run with --no-ai and resolve manually." >&2
            exit 1
        fi
        if ! git diff --check; then
            git rebase --abort
            echo "error: whitespace/marker issues after opencode -- rebase aborted." >&2
            exit 1
        fi
        if ! git rebase --continue; then
            if [ -z "$(git diff --name-only --diff-filter=U || true)" ] && git rev-parse --verify --quiet REBASE_HEAD >/dev/null; then
                git rebase --abort
                echo "error: rebase cannot continue (likely an emptied commit) --" >&2
                echo "inspect with 'git status', then continue manually." >&2
                exit 1
            fi
            git rebase --abort
            echo "error: rebase --continue failed -- rebase aborted." >&2
            exit 1
        fi
        echo "Resolved $STOP_SHA, continuing rebase ..."
    done
    REBASED=true
    echo "Rebase completed with AI resolutions."
else
    if [ "$DEV_BEHIND_MAIN" -ne 0 ] || [ "$MAIN_MOVED" = true ]; then
        REBASED=true
    fi
fi

git diff --check

if [ "$SKIP_VERIFY" = false ] && [ "$REBASED" = true ]; then
    ./script/fork-checks
fi

if [ "$PUSH" = false ]; then
    echo "Synced locally (--no-push). Push when ready:"
    echo "  git push origin main"
    echo "  git push --force-with-lease origin develop"
    exit 0
fi

if [ "$MAIN_MOVED" = true ]; then
    git push origin main
fi
git push --force-with-lease origin develop

echo "Synced: main $(git rev-parse --short main), develop $(git rev-parse --short develop)"
echo "Pushed develop has no CI run -- dispatch fork-checks on develop if you skipped verification:"
echo "  gh workflow run fork-checks.yml --ref develop"
